  "groww_get_positions": {
    "description": "\n    Get user positions for a specific segment.\n    \n    Args:\n        params: segment (e.g., 'CASH', 'FNO')\n    ",
    "parameters": {
      "properties": {
        "params": {
          "additionalProperties": false,
          "properties": {
            "segment": {
              "description": "Market segment (e.g., 'CASH', 'FNO')",
              "type": "string"
            }
          },
          "required": [
            "segment"
          ],
          "type": "object"
        }
      },
      "required": [
        "params"
      ],
      "type": "object"
    }
  },
  "groww_place_order": {
    "description": "\n    Place a new standard order (Equity, FNO).\n    \n    Args:\n        order: StandardOrderInput containing all order details.\n    ",
    "parameters": {
      "properties": {
        "order": {
          "additionalProperties": false,
          "properties": {
            "validity": {
              "default": "DAY",
              "description": "Order validity (e.g., 'DAY', 'IOC')",
              "type": "string"
            },
            "exchange": {
              "description": "Exchange (e.g., 'NSE', 'BSE')",
              "type": "string"
            },
            "order_type": {
              "description": "Order type (e.g., 'LIMIT', 'MARKET', 'SL', 'SL_M')",
              "type": "string"
            },
            "product": {
              "description": "Product type (e.g., 'CASH', 'MIS', 'CNC')",
              "type": "string"
            },
            "quantity": {
              "description": "Order quantity",
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            "segment": {
              "description": "Market segment (e.g., 'CASH', 'FNO')",
              "type": "string"
            },
            "trading_symbol": {
              "description": "Trading symbol (e.g., 'RELIANCE')",
              "type": "string"
            },
            "transaction_type": {
              "description": "Transaction type ('BUY', 'SELL')",
              "type": "string"
            },
            "price": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": 0.0,
              "description": "Order price (required for LIMIT)"
            },
            "trigger_price": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Trigger price (required for SL/SL_M)"
            },
            "order_reference_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Client reference ID"
            }
          },
          "required": [
            "exchange",
            "order_type",
            "product",
            "quantity",
            "segment",
            "trading_symbol",
            "transaction_type"
          ],
          "type": "object"
        }
      },
      "required": [
        "order"
      ],
      "type": "object"
    }
  },
  "groww_modify_order": {
    "description": "\n    Modify an existing pending order.\n    ",
