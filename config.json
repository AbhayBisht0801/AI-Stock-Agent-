  "groww_create_smart_order": {
    "description": "\n    Create a Smart Order (GTT or OCO).\n    \n    For GTT: Provide trigger_price, trigger_direction, order.\n    For OCO: Provide target, stop_loss, transaction_type.\n    ",
    "parameters": {
      "properties": {
        "smart_order_type": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "trading_symbol": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "product_type": {
          "type": "string"
        },
        "exchange": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "trigger_price": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trigger_direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop_loss": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transaction_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "smart_order_type",
        "segment",
        "trading_symbol",
        "quantity",
        "product_type",
        "exchange",
        "duration"
      ],
      "type": "object"
    }
  },
